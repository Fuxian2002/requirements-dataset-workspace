// ================================================================
// SMART-QSO 系统级需求描述 (SpaceRDL)
// 生成日期: 2026-10-09
// 方言: ReqCapByTable (工程拼写)。项目内无既有 SpaceRDL 资产,
//       此为首次生成, 方言选择记录于 README.md。
// 证据与逐条映射: spacerdl/statements.md、spacerdl/traceability.md
// 缺口与冲突: spacerdl/issues.md (禁止臆造数值, 未核实参数不写入)
// ================================================================

Import DeviceRepository;
Import ControllerRepository;
Import AlgorithmRepository;
Import DataDictionary;

System {
  // 控制器: OBC。STM32L476RG (OBC_DESIGN.md:136-151); 主备与 Apollo4 冲突见 ISSUE-020。
  // 控制周期取 1000 ms: ICD_OBC_ADCS.md:301-305 控制环 1000ms、
  // ICD_OBC_EPS.md:288-295 轮询 1Hz 一致; 代码 20ms 主循环冲突见 ISSUE-015。
  Controller CtrOBC obc { ControlPeriod: 1000ms };
  // 设备: EPS 控制器, I2C 地址 0x48 (ICD_OBC_EPS.md:76; 0x50 冲突见 ISSUE-005)
  Device EpsController eps;
  // 设备: RF 收发机 Si4463, SPI Mode0 (ICD_OBC_RF.md:41,58-69,86-88)
  Device RfTransponder rf;
  // 设备: ADCS 板, LIS3MDL 0x1E + LSM6DS3 0x6A + MTQ PWM (ICD_OBC_ADCS.md:57-69,93-98)
  Device AdcsBoard adcs;
  // 设备: AI 载荷 Jetson, UART 115200 8N1 + Power Enable GPIO (ICD_OBC_JETSON.md:29-36,68-74)
  Device JetsonPayload jetson;
  // 设备: 硬件看门狗 IWDG LSI 32kHz (OBC_DESIGN.md:331-335; 超时 5s/30s 冲突见 ISSUE-013)
  Device WdtPeriph wdt;
  // 设备: 部署机构, 烧线 HDRM 2A/3s + 部署开关 (deployment.c:26-29; RF_DESIGN.md:199-226)
  Device DeployMech hdrm;
  // 设备: 大容量存储 FRAM FM25V10 128KB (OBC_DESIGN.md:180-183; 4MB 冲突见 ISSUE-020)
  Device MassMemory fram;
  // 系统边界外: 地面站, ProTC/ProTM 对象 (ICD_SPACE_GROUND.md; 上行存在性冲突见 ISSUE-003)
  Device ExternalSystem ground;
  // 端口连接 (OBC_DESIGN.md:73-79)
  Connect I2C1 eps;
  Connect SPI1 rf;
  Connect I2C2 adcs;
  Connect UART1 jetson;
  Connect RFLink ground;
}

InitTask {
  // REQ-001 (SYS-300, SRS-F001): 上电 30s 内完成初始化并执行飞行软件
  // (main.c:95-171; RTM:123 "Initialize within 30s")
  Composite InitSequence Finished Within 30000ms {
    // REQ-004 (SYS-320-324): 初始化各子系统接口 (OBC_DESIGN.md:73-79;
    // 端口/配置结构名待资源库建立, 见 ISSUE-025)
    Init I2C1 EpsI2CConfig;
    Init I2C2 AdcsI2CConfig;
    Init SPI1 RfSpiConfig;
    Init UART1 JetsonUartConfig;
    // REQ-005 (SYS-021): 配置硬件看门狗 (watchdog_mgr.h:44; 超时值冲突 ISSUE-013)
    Init WDT1 WatchdogConfig;
    // REQ-003 (SRS-F002): 从 NVM 加载配置, 含 CRC 校验 (mission_data.c:78; crc32.c:93-108)
    GetData fram MissionConfigData;
    // REQ-006: 上电后进入 SAFE, RF 抑制生效, 默认信标间隔 60s
    // (COMMISSIONING_PLAN.md:50-58; system_state.c:56-69; eps_control.c:20-29)
    Set powerMode SAFE;
    Set s_rfInhibit true;
    Set beaconInterval 60000;
    Set s_aiEnabled false;
  }
}

AppTask {
  // ============ 主控制周期 (每 ControlPeriod=1000ms 执行一次) ============

  // REQ-013 (SYS-124): 采集 EPS 遥测, 1Hz
  // (ICD_OBC_EPS.md:139-156,275-284; sensors.c:68-137)
  GetData eps {BatteryVoltage, BatteryCurrent, BatteryTemp, Soc, SolarVoltage, SolarCurrent, BusVoltage};
  // REQ-027 (SYS-323, SYS-400-403): 采集 ADCS 传感器
  // (ICD_OBC_ADCS.md:124-171; adcs_control.c:336-382)
  GetData adcs {MagField[3], GyroRate[3], SunVector[3]};

  // REQ-014/015/016 (SRS-F013/F014): 按 SOC 选择功率模式
  // (eps_control.h:41-47; main.c:211-224)
  If (Soc < 0.25) {
    Set powerMode SAFE;
  } Else {
    If (Soc < 0.40) {
      Set powerMode IDLE;
    } Else {
      If (Soc > 0.55 && sunlit) {
        Set powerMode ACTIVE;
      }
    }
  }
  // REQ-017 (SRS-F011): 按模式切换负载通道
  // (eps_control.c:178-207; ICD_OBC_EPS.md:180-186; RF_EN 常开冲突 ISSUE-023)
  Switch (powerMode) {
    Case(SAFE): { SendData eps LoadSwitchSafe; }
    Case(IDLE): { SendData eps LoadSwitchIdle; }
    Case(ACTIVE): { SendData eps LoadSwitchActive; }
  }
  // REQ-020/021 (SYS-503): Jetson 功率门控, SOC<55% 禁止开启
  // (eps_control.c:86-117; ICD_OBC_JETSON.md:89-100)
  If (powerMode == ACTIVE && Soc > 0.55) {
    SendData jetson PowerEnableCmd;
  } Else {
    SendData jetson PowerDisableCmd;
  }

  // REQ-028 (SYS-421): B-dot 消旋 (adcs_control.c:401-423; ADCS_DESIGN.md:212-219)
  If (adcsMode == DETUMBLE) {
    Compute BDotControl {MtqDipole[3]} {MagField[3], MagFieldPrev[3]} ReqCapByTable FormulaTable.B1;
  }
  // REQ-030 (SYS-422): 太阳指向控制 (adcs_control.c:425-472; ADCS_DESIGN.md:249-265)
  If (adcsMode == SUNPOINT) {
    Compute SunPointControl {MtqDipole[3]} {SunVector[3], MagField[3]} ReqCapByTable FormulaTable.B2;
  }
  // REQ-029: 消旋收敛判定 (adcs_control.h:39-45; 300s settling 未建模, 见 ISSUE-037)
  If (rateMag < 0.0087) {
    Set adcsMode SUNPOINT;
  }
  // REQ-030: 阴影/阳照切换 (adcs_control.c:156-214)
  If (adcsMode == SUNPOINT && !sunlit) {
    Set adcsMode ECLIPSE;
  }
  If (adcsMode == ECLIPSE && sunlit) {
    Set adcsMode SUNPOINT;
  }
  // REQ-031 (SYS-412): MTQ PWM 输出 (ICD_OBC_ADCS.md:177-189; adcs_control.c:474-506)
  SendData adcs MtqPwm[3];

  // REQ-055 (MRD-041): 90 分钟能量预报 (PDR.md:5.1; ML_MODELS.md:3;
  // 输入/输出规格未定义, 置信度中, 见 ISSUE-033)
  Compute PowerForecast {EnergyForecast90min} {InsolationHistory, Soc} ReqCapByTable FormulaTable.B3;

  // ============ 10s 周期: 健康检查 (main.c:43 HEALTH_CHECK_INTERVAL_MS 10000) ============
  At(0, 10000ms) Composite HealthCheck {
    // REQ-045 (SRS-F040): 热故障检测与恢复 (main.c:271; fault_mgmt.c:208-218;
    // 阈值多套冲突见 ISSUE-014)
    If (epsTemp > 40.0) {
      Set faultFlag THERMAL;
      SendData jetson PowerDisableCmd;
      Set powerMode IDLE;
      SendData fram FaultLogEntry;
    }
    // REQ-045: 功率故障检测 (main.c:280)
    If (Soc < 0.30) {
      Set faultFlag POWER;
      SendData fram FaultLogEntry;
    }
    // REQ-050 (SRS-F043): 严重故障转 SAFE (fault_mgmt.c:156)
    If (criticalFault) {
      Set powerMode SAFE;
    }
  }

  // ============ 2s 周期: 状态持久化 (main.c:46, 100 tick x 20ms) ============
  At(0, 2000ms) SendData fram MissionStateData;

  // ============ 60s 周期: 遥测发往载荷 (main.c:67,304-379; ICD_OBC_JETSON.md:121) ============
  At(0, 60000ms) SendData jetson TelemetryCsv;

  // ============ 60s 周期: 信标 (REQ-033 SYS-210/211; SRS-P002 总时长<5s) ============
  At(0, 60000ms) Composite BeaconCycle Finished Within 5000ms {
    // REQ-023/024 (SYS-511/512/513): 请求并接收 AI 文本, 10s 超时
    // (ICD_OBC_JETSON.md:160-171,222-228; 校验属 GetData 资源能力)
    If (s_aiEnabled && powerMode != SAFE) {
      GetData jetson BeaconText Finished Within 10000ms;
    }
    // REQ-025/039 (SYS-214/215, SYS-520/521): 无效或无 AI 时回退模板
    // (beacon.c:131-156)
    If (!beaconTextValid) {
      Set beaconText TemplateText;
    }
    // REQ-034/036 (SYS-210/213): AX.25 打包并下行 (beacon.c:220-264; ProTable.B1)
    // REQ-007: RF 抑制解除前不发射 (SRS-S001; deployment.h:33)
    If (!s_rfInhibit) {
      ProTM ground BeaconFrame ReqCapByTable ProTable.B1;
    }
  }

  // ============ 遥控处理 (REQ-040/041/042/043; COMMAND_DICTIONARY.md) ============
  // 命令解析/校验属 ProTC 资源能力; 命令帧方案冲突见 ISSUE-001
  ProTC ground CommandFrame ReqCapByTable ProTable.B2;
  Switch (cmdId) {
    Case(SAFE_MODE): { Set powerMode SAFE; }
    Case(RELEASE_SAFE): { If (Soc > 0.30) { Set powerMode IDLE; } }
    Case(SET_MODE): { Set powerMode TargetModeParam; }
    Case(SET_BEACON_RATE): { Set beaconInterval RateParam; }
    // REQ-037 (SYS-201): 发射功率选择 (COMMAND_DICTIONARY.md:140-150; FC-004)
    Case(SET_TX_POWER): { SendData rf TxPowerCmd; }
    Case(JETSON_POWER): { If (PowerParam == ON) { SendData jetson PowerEnableCmd; } Else { SendData jetson PowerDisableCmd; } }
    Case(AI_ENABLE): { Set s_aiEnabled true; }
    Case(AI_DISABLE): { Set s_aiEnabled false; }
    Case(FORCE_FALLBACK): { Set s_aiEnabled false; Set beaconText TemplateText; }
    Case(REQUEST_TLM): { ProTM ground CommandAck ReqCapByTable ProTable.B1; }
    Case(CLEAR_FAULTS): { Set faultFlags 0; }
    Case(SW_RESET): { SendData wdt ResetSignal; }
  }

  // ============ 部署序列 (REQ-008/009/010; deployment.c:117-208) ============
  // 重试 3 次/60s 延时未建模, 见 ISSUE-037
  If (!s_deploymentComplete) {
    Composite DeploymentSequence {
      GetData hdrm DeploySwitchState;
      In(1800000ms) SendData hdrm AntennaBurnPulse;
      In(10000ms) GetData hdrm AntennaDeployStatus;
      SendData hdrm SolarBurnPulse;
      Set s_deploymentComplete true;
    }
  }

  // ============ EOL 钝化 (REQ-053/054 SYS-800-802; END_OF_LIFE_PLAN.md:37-39,72-106) ============
  If (lastContactAge > 2592000000ms || Soc < 0.15) {
    Set eolFlag true;
  }
  If (eolFlag) {
    SendData eps ChargerDisableCmd;
    SendData rf TxDisableCmd;
    SendData hdrm DragDeployCmd;
  }
}

InterruptTask {
  // REQ-048 (SYS-021): 软件看门狗喂狗 (FDIR_DESIGN.md:345-370 双层 10s/30s;
  // 超时值冲突 ISSUE-013)
  At(0, 10000ms) SendData wdt KickSignal;
  // REQ-007 (SYS-221): 分离 30 分钟后解除 RF 抑制
  // (deployment.h:33; COMMISSIONING_PLAN.md:64-87)
  At(1800000ms) Set s_rfInhibit false;
}

SystemConstraints {
  // REQ-061: 内存上限 STM32L476RG RAM 128KB / Flash 1MB (OBC_DESIGN.md:136-151;
  // Apollo4 2MB RAM 冲突见 ISSUE-020)
  Executed Within 128kb;
  // REQ-061: 语言标准 (software/flight/CMakeLists.txt:19)
  Language Standard C11;
  // 以下为原文约束, SpaceRDL 无对应语法, 保留为显式引用, 不伪装成原子操作:
  // REQ-059: SOC 绝对下限 15% (MISSION_RULES.md FC-001)
  // REQ-060: AI 推理占空比 <= 10%, 单次连续 <= 60s, 最小关闭间隔 540s (MISSION_RULES.md FC-003)
  // REQ-037: RF 发射功率 <= 2W; LOW 0.5W 标准 / MEDIUM 1.0W 优先 / HIGH 2.0W 仅应急 (FC-004)
  // REQ-062: 全部下行明文无加密 (MRD-025, 47 CFR Part 97)
  // REQ-063: 无地面接触自主运行 7 天 (MRD-002)
  // REQ-064: 组件热限 (多套阈值冲突, 见 ISSUE-014)
}
