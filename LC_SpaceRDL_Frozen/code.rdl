                    // ST-LC-0247 REQ: REQ-LC-0015, REQ-LC-0059
                    Compute WWDTValidationMIDOK WWDTValidationWorking ReqCapByFormTable FormulaTable.WWDTValidationMIDOK;
                    If (WWDTValidationMIDOK) {
