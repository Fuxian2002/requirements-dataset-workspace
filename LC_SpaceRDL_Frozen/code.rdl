            // ST-LC-0243 REQ: REQ-LC-0015, REQ-LC-0059
            Compute WWDTValidationDataTypeOK WWDTValidationWorking ReqCapByFormTable FormulaTable.WWDTValidationDataTypeOK;
            If (WWDTValidationDataTypeOK) {
