                // ST-LC-0245 REQ: REQ-LC-0010, REQ-LC-0015, REQ-LC-0059
                Compute WWDTValidationOperatorOK WWDTValidationWorking ReqCapByFormTable FormulaTable.WWDTValidationOperatorOK;
                If (WWDTValidationOperatorOK) {
                    // ST-LC-0246 REQ: REQ-LC-0015, REQ-LC-0059
